# ENTSO-E API access used by the n8n HTTP Request expression.
ENTSOE_SECURITY_TOKEN=replace_with_real_token

# PostgreSQL values are configured in an n8n PostgreSQL credential.
POSTGRES_HOST=replace_with_host
POSTGRES_PORT=5432
POSTGRES_DB=replace_with_database
POSTGRES_USER=replace_with_user
POSTGRES_PASSWORD=replace_with_password
POSTGRES_SSL_MODE=require

# Non-secret collector reference values.
GRID_FREQUENCY_URL=https://dat.netzfrequenzmessung.de:9080/frequenz.xml
GRID_FREQUENCY_TARGET_HZ=50.000
GRID_FREQUENCY_POLL_SECONDS=3
SMARD_INDEX_URL=https://www.smard.de/app/chart_data/4169/DE-LU/index_quarterhour.json
SMARD_PRICE_POLL_MINUTES=15
ENTSOE_API_BASE_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_DE_LU_DOMAIN=10Y1001A1001A82H
ENTSOE_PRICE_DOCUMENT_TYPE=A44
ENTSOE_PRICE_POLL_MINUTES=15
