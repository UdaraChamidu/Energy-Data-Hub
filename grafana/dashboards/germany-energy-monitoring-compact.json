    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Price for the delivery interval active now. Auto prefers ENTSO-E and falls back to SMARD.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "suffix: EUR/MWh"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 17,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "id": 106,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "limit": 1,
          "values": false
        },
        "showPercentChange": false,
        "text": {
          "valueSize": 56
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH chosen_source AS (\n  SELECT s.id\n  FROM energy_data.data_sources s\n  WHERE s.code IN ('entsoe', 'smard')\n    AND (\n      ${price_source:sqlstring} = 'auto'\n      OR s.code = ${price_source:sqlstring}\n    )\n    AND EXISTS (\n      SELECT 1\n      FROM energy_data.market_price_points candidate\n      JOIN energy_data.markets candidate_market\n        ON candidate_market.id = candidate.market_id\n      WHERE candidate.source_id = s.id\n        AND now() >= candidate.delivery_start\n        AND now() < candidate.delivery_end\n        AND candidate.product IN (\n          'day_ahead',\n          'quarter_hour_day_ahead',\n          'hour_day_ahead'\n        )\n        AND candidate_market.country_code = 'DE'\n    )\n  ORDER BY CASE s.code WHEN 'entsoe' THEN 1 WHEN 'smard' THEN 2 ELSE 99 END\n  LIMIT 1\n)\nSELECT\n  p.price_eur_mwh AS \"Current Price\"\nFROM energy_data.market_price_points p\nJOIN chosen_source selected ON selected.id = p.source_id\nJOIN energy_data.markets m ON m.id = p.market_id\nWHERE now() >= p.delivery_start\n  AND now() < p.delivery_end\n  AND p.product IN ('day_ahead', 'quarter_hour_day_ahead', 'hour_day_ahead')\n  AND m.country_code = 'DE'\nORDER BY p.ingested_at DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "title": "Current Delivery Price",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Latest calculated grid time displayed in Europe/Berlin local time.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
